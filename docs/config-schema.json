{
  "$ref": "#/definitions/ProductionCheckConfig",
  "definitions": {
    "ProductionCheckConfig": {
      "type": "object",
      "properties": {
        "extends": {
          "type": "string",
          "const": "recommended"
        },
        "ignore": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          ]
        },
        "rules": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "error",
              "warn",
              "off"
            ]
          }
        },
        "severity": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          }
        },
        "confidence": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "failOn": {
          "$ref": "#/definitions/ProductionCheckConfig/properties/severity/additionalProperties"
        },
        "cache": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
