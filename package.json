{
  "name": "production-check",
  "version": "0.1.0",
  "description": "Scan AI-generated applications for security, reliability, configuration, infrastructure, and production-readiness problems.",
  "type": "module",
  "bin": {
    "production-check": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:action": "esbuild action/src/action.ts --bundle --platform=node --format=cjs --minify --outfile=action/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "gen:schema": "npm run build && node scripts/generate-config-schema.mjs",
    "prepublishOnly": "npm run build && npm test && npm run lint"
  },
  "keywords": [
    "vibe-coding",
    "ai",
    "ai-generated-code",
    "developer-tools",
    "devsecops",
    "security",
    "static-analysis",
    "production-readiness",
    "code-scanning",
    "typescript",
    "cli",
    "docker"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibecoder/production-checker.git"
  },
  "homepage": "https://github.com/vibecoder/production-checker#readme",
  "bugs": {
    "url": "https://github.com/vibecoder/production-checker/issues"
  },
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "picocolors": "^1.1.0",
    "typescript": "^5.6.2",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "@typescript-eslint/eslint-plugin": "^8.6.0",
    "@typescript-eslint/parser": "^8.6.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.10.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "zod-to-json-schema": "^3.25.2"
  }
}
